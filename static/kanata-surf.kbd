;;
(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    bksl
  caps a    s    d    f    g    h    j    k    l    scln apos      ent
  lsft z    x    c    v    b    n    m    comm .    /    up        rsft
  lctl lmet lalt           spc            ralt rctl left down      right
)

(defalias
  cap1 (layer-toggle layer1)
  entctl (tap-hold 200 200 ent lctl)
)

(deflayer base
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    bksl
  @cap1 a    s    d    f    g    h    j    k    l    scln apos      @entctl
  lsft z    x    c    v    b    n    m    comm .    /    up        rsft
  lctl lmet lalt           spc            ralt rctl left down      right
)

(deflayer layer1
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   _    mlft mmid mrgt mbck _    _    _
  _    f6   f7   f8   f9   f10  left down up   right _    _         lctl
  _    _    _    _    _    _    home end  pgup pgdn _    _         _
  _    _    _              _              _    _    _    _         _
)
