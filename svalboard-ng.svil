              "showIf": "{app_pads_os} == 0",
              "content": [
                "id_pad_hold",
                0,
                53
              ]
            },
            {
              "label": "Hold Time (ms)",
              "type": "range",
              "options": [
                20,
                1500,
                10
              ],
              "showIf": "{app_pads_os} == 0",
              "disabledIf": "{id_pad_hold} == 0",
              "content": [
                "id_pad_hold_ms",
                0,
                54
              ]
            },
            {
              "label": "Tune touchpad…",
              "type": "link",
              "content": [
                "app:touchpad-tuning"
              ]
            },
            {
