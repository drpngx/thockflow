                0,
                2
              ]
            },
            {
              "label": "Scroll Mode",
              "type": "toggle",
              "content": [
                "id_right_scroll",
                0,
                3
              ]
            }
          ]
        },
        {
          "label": "Auto Mouse",
          "content": [
            {
              "label": "Enable Auto Mouse",
              "type": "toggle",
              "content": [
                "id_automouse_enable",
                0,
                4
              ]
            },
            {
              "showIf": "{id_automouse_enable} == 1",
              "content": [
                {
                  "label": "No Layer Timeout",
                  "type": "toggle",
                  "content": [
                    "id_automouse_no_timeout",
                    0,
                    50
                  ]
                },
                {
                  "showIf": "{id_automouse_no_timeout} == 0",
                  "content": [
                    {
                      "label": "Layer Timeout (ms)",
                      "type": "range",
                      "options": [
                        100,
                        2000,
                        10
                      ],
                      "content": [
                        "id_automouse_timeout_ms",
                        0,
                        49
                      ]
                    }
                  ]
                },
                {
                  "label": "Activation Threshold",
                  "type": "range",
                  "options": [
                    0,
                    1000
                  ],
                  "content": [
                    "id_automouse_threshold",
                    0,
                    6
                  ]
                },
                {
                  "label": "Activation Decay (x10ms)",
                  "type": "range",
                  "options": [
                    0,
                    255
                  ],
                  "content": [
                    "id_automouse_decay",
                    0,
                    10
                  ]
                },
                {
                  "label": "Left Pointer Activates",
                  "type": "toggle",
                  "content": [
                    "id_left_automouse",
                    0,
                    11
                  ]
                },
                {
                  "label": "Right Pointer Activates",
                  "type": "toggle",
                  "content": [
                    "id_right_automouse",
                    0,
                    12
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Touchpad",
          "note": "Windows and Linux use their native Precision Touchpad Protocol by default. Mac is limited to the built-in gestures from Azoteq.",
          "content": [
            {
              "label": "Touchpad Mode",
              "type": "dropdown",
              "options": [
                "Automatic",
                "Built-in gestures"
              ],
              "content": [
                "id_pad_touchpad_mode",
                0,
                59
              ]
            },
            {
              "label": "Tap to Click",
              "type": "toggle",
              "showIf": "{app_pads_os} == 0",
              "content": [
                "id_pad_tap",
                0,
                51
              ]
            },
            {
              "label": "Two-Finger Tap to Right Click",
              "type": "toggle",
              "showIf": "{app_pads_os} == 0",
              "content": [
                "id_pad_two_finger",
                0,
                52
              ]
            },
            {
