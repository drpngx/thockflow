    name = "zmk_studio_messages",
    build_file = "//proto:zmk_studio_messages.BUILD",
    strip_prefix = "zmk-studio-messages-6cb4c283e76209d59c45fbcb218800cd19e9339d",
    urls = ["https://github.com/zmkfirmware/zmk-studio-messages/archive/6cb4c283e76209d59c45fbcb218800cd19e9339d.zip"],
)

