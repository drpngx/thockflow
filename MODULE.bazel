    name = "zmk",
    build_file_content = """
filegroup(
    name = "app",
    srcs = glob(["app/**"]),
    visibility = ["//visibility:public"],
)
filegroup(
    name = "behaviors",
    srcs = glob(["app/dts/behaviors.dtsi", "app/dts/behaviors/**"]),
    visibility = ["//visibility:public"],
)
exports_files(glob(['**']))
""",
    sha256 = "edc66c6eecabcca4b06b25e041af71a3dff656a322725e6f1c63d97aa8b31732",
    strip_prefix = "zmk-a23aa009d7a07d67fe5609caca7372e16610f238",
